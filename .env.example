# Copy to .env and fill in. Only DB_PASSWORD and ADMIN_API_KEY are required.
DB_PASSWORD=change-me
ADMIN_API_KEY=change-me

# Local development defaults. For a real box set all four to your hostnames.
SITE_DOMAIN=localhost
CONTENT_HOST=sites.localhost
SITE_ADDR=http://localhost
CONTENT_ADDR=http://sites.localhost
PUBLIC_BASE_URL=http://localhost

# Production only: Caddy issues certificates automatically once these are
# real hostnames pointing at this box. ACME_EMAIL is where expiry notices go.
# SITE_ADDR=hack.example.com
# CONTENT_ADDR=sites.hack.example.com
# ACME_EMAIL=you@example.com

# Optional. Email sign-in codes are disabled without a Resend key.
RESEND_API_KEY=
MAIL_FROM=

# Event hostnames, public instance only. Unset means organisers bring their own
# domain. EVENT_DOMAINS is a comma-separated list of zones this token can write.
EVENT_DNS_TOKEN=
EVENT_DNS_TEAM_ID=
EVENT_DOMAINS=
