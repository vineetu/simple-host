# Copy to .env and fill in. Only DB_PASSWORD and ADMIN_API_KEY are required.
DB_PASSWORD=change-me
ADMIN_API_KEY=change-me

# Local development defaults. For a real box set all four to your hostnames.
SITE_DOMAIN=localhost
CONTENT_HOST=sites.localhost
SITE_ADDR=http://localhost
CONTENT_ADDR=http://sites.localhost
PUBLIC_BASE_URL=http://localhost

# Production only: Caddy issues certificates automatically once these are
# real hostnames pointing at this box. ACME_EMAIL is where expiry notices go.
# SITE_ADDR=hack.example.com
# CONTENT_ADDR=sites.hack.example.com
# ACME_EMAIL=you@example.com

# Optional. Email sign-in codes are disabled without a Resend key.
RESEND_API_KEY=
MAIL_FROM=

# Optional. Google sign-in. The redirect URI to register is
# https://<your host>/v1/auth/oauth/google/callback . The server refuses to
# start if exactly one of these two is set.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Event hostnames, public instance only. Unset means organisers bring their own
# domain. EVENT_DOMAINS is a comma-separated list of zones this token can write.
EVENT_DNS_TOKEN=
EVENT_DNS_TEAM_ID=
EVENT_DOMAINS=

# How big one site may be, in megabytes. Unset keeps the built-in 100 MB. Real
# sites are nowhere near it — the median site on simple-host is 25 KB — so this
# is a guard against one upload filling a disk, not a budget. What is actually
# being used is reported by GET /v1/admin/usage.
#MAX_ARCHIVE_MB=100
# deploy/install/install.sh writes this from --max-site-mb, and preserves it on
# a re-run. To change it on a running instance: edit this file, then
# `docker compose up -d`.

# How many deploys of a site to keep. Unset or 0 keeps every version, which is
# what simple-host.app does. An event box sets 1: each version is a full copy of
# the site and the live tree is another, so an agent that redeploys a page ten
# times costs eleven copies of it. deploy/install/install.sh writes 1.
# The trade is rollback — at 1 there is no earlier version to return to.
#KEEP_VERSIONS=1

# Operational times and limits: sign-in code lifetime, keys and sites per
# account, how long links, sessions and Recently deleted last, domain and
# cleanup timings, rate limits. Unset keeps the value shown, which is what
# simple-host.app runs. docs/configuration.md explains each one and its range;
# a bad value stops the server with an error naming it. install.sh keeps
# these on a re-run.
#SIGNIN_CODE_TTL_MINUTES=15
#MAX_KEYS_PER_ACCOUNT=50
#KEY_IDLE_EXPIRY_DAYS=180
#HANDLE_RENAME_EVERY_DAYS=30
#EMAIL_CHANGE_UNDO_DAYS=7
#MAX_SITES_PER_ACCOUNT=100
#MAX_SITES_OVERRIDES=
#MAX_ARCHIVE_MB_OVERRIDES=
#MAX_FILES_PER_SITE=50000
#PREVIEW_LINK_TTL_MINUTES=60
#EXPORT_LINK_TTL_MINUTES=10
#SITE_PASSCODES=on
#PASSCODE_MIN_LENGTH=6
#SITE_VIEWERS_MAX=50
#PASSCODE_LOCKOUT_MINUTES=15
#PASSCODE_SITE_LOCKOUT_MINUTES=15
#VISITOR_SESSION_DAYS=30
#VISITOR_SESSION_IDLE_DAYS=14
#OAUTH_ACCESS_TTL_MINUTES=60
#OAUTH_REFRESH_TTL_DAYS=90
#OAUTH_UNUSED_CLIENT_DAYS=30
#DOMAIN_UNPROVEN_HOURS=24
#DOMAIN_UNPROVEN_MAX_DAYS=7
#DOMAIN_LAPSE_WARN_HOURS=24
#DOMAIN_LAPSE_HOURS=72
#DOMAIN_CHECK_INTERVAL_MINUTES=2
#DOMAIN_CERTS_PER_ACCOUNT_DAILY=5
#ADDRESS_FAMILIES=on
#ADDRESS_FAMILIES_PER_ACCOUNT=5
#ADDRESS_FAMILY_UNPROVEN_HOURS=24
#ADDRESS_FAMILY_LAPSE_WARN_HOURS=24
#ADDRESS_FAMILY_LAPSE_HOURS=72
#ADDRESS_FAMILY_CHECK_INTERVAL_MINUTES=10
#ADDRESS_FAMILY_ACTIVE_RECHECK_MINUTES=60
#ADDRESS_FAMILY_CERTS_PER_ACCOUNT_DAILY=12
#ADDRESS_FAMILY_RESERVED_LABELS=www
#ADDRESS_FAMILY_CACHE_SECONDS=30
#EVENT_TTL_DAYS=21
#EVENT_MAX_CLAIMS=5
#EVENTS=off
#EVENT_NAME_PEER=
#EVENT_CREATE_PER_DAY=3
#EVENT_MAX_ACTIVE_PER_ORGANISER=2
#EVENT_TEAM_SIZE_DEFAULT=4
#EVENT_SITES_KEEP_DAYS=30
#EVENT_REMOVAL_WARN_DAYS=14
#HACK_INSTANCE_BUDGET_GB=10
#HACK_EVENT_ICON_MAX_BYTES=131072
#DELETED_RETENTION_DAYS=7
#IDLE_AFTER_DAYS=90
#IDLE_GRACE_DAYS=30
#IDLE_EXEMPT_FAMILY_SITES=on
#IDLE_REPLY_TO=support@simple-host.app
#ANALYTICS_RETENTION_DAYS=400
#ANALYTICS_PAGES_PER_SITE_DAY=200
#ANALYTICS_REFERRERS_PER_SITE_DAY=100
#API_METRICS_RETENTION_DAYS=30
#NETWORK_MONTHLY_ALLOWANCE_GB=10240
#NETWORK_ALERT_PCT=75
#NETWORK_SAMPLE_MINUTES=60
#API_GROWTH_RETENTION_DAYS=400
#API_METRICS_FLUSH_SECONDS=20
#RATE_LIMIT_SIGNIN_IP=20,5s
#RATE_LIMIT_SIGNIN_EMAIL=5,50s
#RATE_LIMIT_VISITOR_OAUTH=20,5s
#RATE_LIMIT_VISITOR_AUTH=20,5s
#RATE_LIMIT_VISITOR=20,5s
#RATE_LIMIT_UPLOAD=30,10s
#RATE_LIMIT_STORAGE_IP=120,100ms
#RATE_LIMIT_STORAGE_VISITOR=60,200ms
#SITE_STORAGE_FILES_MAX_OBJECTS=1000
#RATE_LIMIT_STATE=60,1s
#RATE_LIMIT_SITE_OPS=30,2s
#RATE_LIMIT_EXPORT=10,10s
#RATE_LIMIT_ANALYTICS=30,2s
#RATE_LIMIT_TLS_ASK=60,100ms
#RATE_LIMIT_DOMAIN_CHECK=10,10s
#RATE_LIMIT_DOMAIN_CHECK_USER=3,30s
#RATE_LIMIT_ADDRESS_FAMILY_CHECK=10,10s
#RATE_LIMIT_ADDRESS_FAMILY_CHECK_USER=3,30s
#RATE_LIMIT_HANDLE_CHECK=30,2s
#RATE_LIMIT_EVENT_CODES_IP=120,1s
#RATE_LIMIT_EVENT_CODES_USER=20,3s
#RATE_LIMIT_EVENT_NAMES_USER=60,1s
#RATE_LIMIT_OAUTH_REGISTER=10,6m
#RATE_LIMIT_OAUTH_AUTHORIZE=30,2s
#RATE_LIMIT_OAUTH_TOKEN=30,2s
#RATE_LIMIT_PASSCODE_IP=5,3m
#RATE_LIMIT_PASSCODE_SITE=60,1m
# Saved data (what pages save: state and lists). Every change is kept this many
# days and can be restored by the site owner; deleted list items stay as long.
# Unset keeps the defaults shown; docs/configuration.md gives each range, a bad
# value stops the server, and install.sh keeps these on a re-run.
#SAVED_DATA_UNDO_DAYS=30
# Per-site history above this is thinned, oldest first, always keeping each
# item's first change of every day: at once when a write crosses it, and by
# the sweep.
#SAVED_DATA_HISTORY_MAX_MB=20
# A site's live saved data (page data and list items; not history or Recently
# deleted) may not grow past this (507 site_full). Writes that do not grow it
# always go through.
#SAVED_DATA_SITE_MAX_MB=50
# A change made with ops keeps only what it changed in history, with a full
# copy at least this often and on the first change of each day.
#SAVED_DATA_SNAPSHOT_EVERY=50
# How often expired history and deleted items are removed.
#SAVED_DATA_SWEEP_MINUTES=15
# The watch (GET /v1/admin/data-watch): the window, and what counts as a large
# visitor increment and a large list item.
#SAVED_DATA_WATCH_DAYS=7
#SAVED_DATA_WATCH_INC_MAX=10
#SAVED_DATA_WATCH_ITEM_KB=16
# Watch counts older than this are removed.
#SAVED_DATA_WATCH_KEEP_DAYS=90
# How long a write's first answer is replayed for a retry with the same
# Idempotency-Key.
#SAVED_DATA_IDEMPOTENCY_HOURS=24
# Remembered Idempotency-Keys per site; the oldest past this are dropped.
#SAVED_DATA_IDEMPOTENCY_MAX_PER_SITE=10000
# Saved-data reads per second per site and address (per key for owner keys and
# the connector), and the burst above it.
#SAVED_DATA_READ_PER_SEC=30
#SAVED_DATA_READ_BURST=60
# List items one address may add per minute without the owner's key, and the
# burst above it.
#SAVED_DATA_APPEND_PER_MIN=30
#SAVED_DATA_APPEND_BURST=30
# Kinds (Page info and Submissions): the size of one Page info document and how
# many Page info names a site may declare; the size of one new Submissions
# entry and how many live entries one name holds.
#SAVED_DATA_CONTENT_MAX_KB=1024
#SAVED_DATA_CONTENT_NAMES_MAX=20
#SAVED_DATA_ENTRY_MAX_KB=16
#SAVED_DATA_ENTRIES_MAX=10000
# How long a visitor can bring back an entry they withdrew.
#SAVED_DATA_WITHDRAW_UNDO_MINUTES=10
# Email on new submissions: "each" sends at most one email per name this often;
# "daily" at most one digest per name this often.
#SAVED_DATA_NOTIFY_EACH_MINUTES=10
#SAVED_DATA_NOTIFY_DAILY_HOURS=24
# Emails and domains in one site's who-may-save and block lists together.
#SAVED_DATA_SAVERS_MAX=500
# Submissions names one site may declare.
#SAVED_DATA_ENTRIES_NAMES_MAX=50
# Personal (one private record per visitor): KB per record, names per site.
# Shared board: KB per item, live items per board, boards per site.
#SAVED_DATA_PERSONAL_MAX_KB=64
#SAVED_DATA_PERSONAL_NAMES_MAX=20
#SAVED_DATA_BOARD_ITEM_MAX_KB=16
#SAVED_DATA_BOARD_MAX=2000
#SAVED_DATA_BOARD_NAMES_MAX=20
# People with a record in one Personal name; board adds, changes and deletes
# per signed-in person per minute (on top of the per-address rate).
#SAVED_DATA_PERSONAL_PEOPLE_MAX=1000
#SAVED_DATA_BOARD_WRITES_PER_MIN=30
# A name a page saves to without declaring a kind: "shared" (anyone reads it,
# signed-in visitors save to it; the default) or "declare_first" (it takes no
# saves until the owner declares it). Sites made before the kinds stay Shared.
#SAVED_DATA_DEFAULT_KIND=shared
# Maximum plain-text bio length on personal showcases (1-2000 characters).
#SHOWCASE_BIO_MAX_LENGTH=280

# Website file allowances: 0/blank leaves self-hosted caps off.
#KEEP_VERSIONS_SELF_SET=
#KEEP_VERSIONS_OVERRIDES=
#MAX_SITE_TOTAL_MB=0
#SITE_TOTAL_CAP_FROM=
#MAX_SITE_TOTAL_OVERRIDES=
#MAX_ACCOUNT_MB=0
#MAX_ACCOUNT_MB_OVERRIDES=

# SQLite process concurrency: 0 selects the CPU count. Visitor limits apply to writes per site.
#SITE_STORAGE_SQL_CONCURRENCY=0
#SITE_STORAGE_ACQUIRE_WAIT_MS=250
#SITE_STORAGE_WRITE_LOCK_WAIT_MS=2000
#SITE_STORAGE_OWNER_TIMEOUT_MS=5000
#SITE_STORAGE_VISITOR_WRITE_TIMEOUT_MS=2000
#SITE_STORAGE_VISITOR_QUERY_TIMEOUT_MS=1000
