# /etc/simple-host-next.env — every setting the new service reads (next/app/app.go FromEnv).
# Right column: where the value comes from today (the OLD service's setting NAME in
# /etc/simple-host.env, or where else). Names only; copy values on the server, never into git.
# Settings not listed here are not read by the new service.

# Where to listen. Old: BIND_ADDR (127.0.0.1:8090). Must differ from the old one.
SH_ADDR=127.0.0.1:8095
# Postgres. Old: DB_DSN (same server, but a NEW, empty database, e.g. simplehost_next,
# owned by a new role; the service makes its tables on first start).
DATABASE_URL=postgres://simplehost_next:CHANGE_ME@127.0.0.1/simplehost_next?sslmode=disable
# Data folder. Old: DATA_DIR (/srv/simple-host/…); new folder, filled by sh-copy.
SH_DATA_DIR=/srv/simple-host-next
# Old: host part of PUBLIC_BASE_URL / SITE_DOMAIN (simple-host.app).
SH_APP_DOMAIN=simple-host.app
# Old: SITE_BASE_DOMAIN (simple-host.site).
SH_SITE_DOMAIN=simple-host.site
# Old: PASSCODE_ENC_KEY — the SAME value, or carried passcodes and the push key cannot be opened.
PASSCODE_ENC_KEY=
# Old: RESEND_API_KEY (same value).
RESEND_API_KEY=
# Old: MAIL_FROM (same value; unset there means the old default sender).
MAIL_FROM=Simple Host <hello@simple-host.app>
# Old: TURNSTILE_SITE_KEY, and TURNSTILE_SECRET (or the file named by TURNSTILE_SECRET_FILE).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# Old: GOOGLE_OAUTH_CLIENT_ID / GOOGLE_OAUTH_CLIENT_SECRET (same Google client; its
# registered redirect URI https://simple-host.app/v1/auth/oauth/google/callback is unchanged).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Company sign-in. Old: OIDC_CLIENT_ID / OIDC_CLIENT_SECRET / OIDC_ISSUER (the three URLs
# come from the issuer's discovery document). Not set on the hosted service: leave empty.
COMPANY_CLIENT_ID=
COMPANY_CLIENT_SECRET=
COMPANY_AUTH_URL=
COMPANY_TOKEN_URL=
COMPANY_USER_URL=
# 2nd and 3rd certificate issuers, "<key id>:<base64url HMAC>". Old: not a service setting;
# the cert scripts read GOOGLE_EAB_FILE / ZEROSSL_EAB_FILE (/etc/simple-host-secrets/*-eab.json).
ACME_EAB_GOOGLE=
ACME_EAB_ZEROSSL=
# Browser push: base64url of the P-256 private key (32 bytes). Old: not an env setting; the
# instance_config row web_push_vapid_private in the old database, sealed with PASSCODE_ENC_KEY.
# Use the SAME key (unsealed, re-encoded) so the carried push subscription keeps working.
SH_VAPID_KEY=
# Old: AGENTCAT_PROJECT_ID (same value). SH_AGENTCAT_URL: leave unset (default).
AGENTCAT_PROJECT_ID=
# Hosted service: leave unset (no first-run /setup).
SH_SELF_HOSTED=
# Cloudflare purge for *.simple-host.site. Old: none (new). Zone id of simple-host.site and a
# token with Zone → Cache Purge only. Leave empty if simple-host.site is not proxied.
CF_ZONE_ID=
CF_API_TOKEN=
# Country file for the admin map. Old: GEOIP_DIR (default <DATA_DIR>/../geoip) + dbip-city-lite.mmdb.
# Copy the file into the new folder (the old folder is not readable by the new user).
SH_COUNTRY_FILE=/srv/simple-host-next/geoip/dbip-city-lite.mmdb
