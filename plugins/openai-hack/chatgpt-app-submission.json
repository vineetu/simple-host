  "test_cases": [
    {
      "description": "Check an event name and create a draft event.",
      "user_prompt": "Check whether review-jam-2027 is free. If it is, create a draft hackathon called Review Jam 2027, organised by Ada Example, contact ada@example.org, for 20 people, starting 2027-03-06 in Europe/London. Purpose: a one-day student build.",
      "tools_triggered": "hack_check_event_name, hack_create_event",
      "expected_output": "Calls hack_check_event_name for review-jam-2027. If it is free, confirms the details, then calls hack_create_event once with them. Reports the draft's address and stage, and the join and judge links exactly as returned. Does not open sign-up, post announcements or publish a website."
    },
    {
      "description": "Open sign-up for a draft event and share its join link.",
      "user_prompt": "Open sign-up for review-build-day and give me the join link.",
      "tools_triggered": "hack_get_event, hack_set_event_stage",
      "expected_output": "Reads the event with hack_get_event, says what opening sign-up does and waits for a yes, then calls hack_set_event_stage with stage open once. Gives the join link exactly as returned. May offer an announcement, but posts or emails nothing unless asked."
    },
    {
      "description": "Join an event with a join code and create a team.",
      "user_prompt": "Join the hackathon with join code TODO-OWNER-JOIN-CODE. I have read the code of conduct and I accept it. Then create a team called Review Rockets.",
      "tools_triggered": "hack_preview_join, hack_join_event, hack_create_team",
      "expected_output": "Previews the join code and shows the event and its code of conduct, then calls hack_join_event with accept_coc true. Asks before creating the team, then calls hack_create_team once with the name Review Rockets. The reviewer becomes the team's admin. No other team is joined or changed."
    },
    {
      "description": "Publish the team's website under the event.",
      "user_prompt": "Publish a one-page website for my team Review Rockets that says what we are building: a study timer.",
      "tools_triggered": "hack_get_my_teams, create_site",
      "expected_output": "Finds the team and its event with hack_get_my_teams, asks before the first publication, then calls create_site once with the team's site name and owner set to the event's name. Gives the team site's address exactly as returned. No other site is changed or deleted."
    },
    {
      "description": "Read the judging queue and rubric, then score one entry.",
      "user_prompt": "I am judging review-judging-day. Show my queue and the rubric, then give Pixel Pushers 4 out of 5 on every criterion with the comment: Clear demo.",
      "tools_triggered": "hack_get_judge_queue, hack_get_rubric, hack_score_team",
      "expected_output": "Reads the queue and the rubric, confirms the scores and comment with the judge, then calls hack_score_team once for Pixel Pushers with one score per criterion. Does not change the rubric, other judges' scores or any conflict."
    }
  ],
  "negative_test_cases": [
    {
      "description": "Brainstorming does not need the connector.",
      "user_prompt": "Give me ten theme ideas for a student hackathon.",
      "tools_triggered": "None",
      "expected_output": "Answers in chat with theme ideas. Does not call any Simple Hack tool or create anything."
    },
    {
      "description": "Running server code is outside what team websites do.",
      "user_prompt": "Deploy our team's Flask API with a Postgres database for our hackathon project.",
      "tools_triggered": "None",
      "expected_output": "Explains that a team website serves static files with built-in KV, SQLite and file storage, and does not run the team's own server code. Deploys nothing. May offer a static front end instead."
    },
    {
      "description": "Events on other platforms are outside the connector.",
      "user_prompt": "Register me for a hackathon listed on devpost.com.",
      "tools_triggered": "None",
      "expected_output": "Explains that Simple Hack works only with events on simple-hack.app and cannot register anyone elsewhere. Does not call any Simple Hack tool."
    }
  ]
}
