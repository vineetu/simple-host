{
  "name": "simple-host-web",
  "private": true,
  "type": "module",
  "scripts": {
    "host:dev": "vite -c host/vite.config.ts",
    "host:build": "vite build -c host/vite.config.ts",
    "host:catalogue": "vite build -c host/vite.config.ts --mode catalogue",
    "host:typecheck": "tsc -p host",
    "host:test": "vitest run -c host/vitest.config.ts",
    "host:visual": "playwright test -c host/playwright.config.ts --project=catalogue",
    "host:visual:accept": "playwright test -c host/playwright.config.ts --project=catalogue --update-snapshots",
    "host:real": "playwright test -c host/playwright.config.ts --project=real",
    "hack:dev": "vite -c hack/vite.config.ts",
    "hack:build": "vite build -c hack/vite.config.ts",
    "hack:catalogue": "vite build -c hack/vite.config.ts --mode catalogue",
    "hack:typecheck": "tsc -p hack",
    "hack:test": "vitest run -c hack/vitest.config.ts",
    "hack:visual": "playwright test -c hack/playwright.config.ts --project=catalogue",
    "hack:visual:accept": "playwright test -c hack/playwright.config.ts --project=catalogue --update-snapshots",
    "hack:real": "playwright test -c hack/playwright.config.ts --project=real",
    "lint": "eslint ."
  },
  "dependencies": {
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-table": "8.21.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "radix-ui": "1.4.3",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-router": "7.18.5",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.5.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "7.3.8",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "3.2.7"
  }
}
