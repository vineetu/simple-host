# simple-host-domain-certs: written by /usr/local/sbin/simple-host-domain-certs
# for the custom domain __DOMAIN__. Do not edit by hand: it is rewritten on
# every issue and removed when the domain is disconnected. A domain that any
# other enabled server already names in server_name is hand-made; the issuer
# leaves such domains alone.
#
# Its www / bare partner (www.brand.com for brand.com, and the reverse), when
# it is on the certificate, is a redirect-only host: the block between the
# PARTNER markers is kept with the partner's name filled in, or removed whole.
#
# Custom domain -> the one site it is bound to. Content is served from the
# domains farm (domains/<domain> -> by-id/<user_id>/<site>); /v1 and
# /internal go to the app (same-origin state, collections and sign-in).
server {
    listen 443 ssl;
    server_name __DOMAIN__;

    # Required for the site's analytics to count anything.
    access_log /var/log/simple-host/analytics.log shanalytics;

    ssl_certificate     /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;

    location ^~ /v1/ {
        proxy_pass http://127.0.0.1:8090;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    # internal: reached only through this file's rewrites and error pages;
    # a request from outside gets 404 (nginx-internal-lock.sh).
    location ^~ /internal/ {
        internal;
        proxy_pass http://127.0.0.1:8090;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    root /srv/simple-host/sites/domains/__DOMAIN__/current;
    index index.html;
    # Taken down by the operator: the app's take-down page; taken offline by
    # its owner: the offline page; locked by its owner with a passcode: the
    # app's passcode gate, keeping the path and query (take-down > offline >
    # passcode, so they stand in that order). Inside location / so /v1/ (the
    # owner's API; the app refuses visitors itself) is not caught.
    location / {
        if (-f /srv/simple-host/sites/domains/__DOMAIN__/suspended) { rewrite ^ /internal/suspended last; }
        if (-f /srv/simple-host/sites/domains/__DOMAIN__/offline) { rewrite ^ /internal/offline last; }
        if (-f /srv/simple-host/sites/domains/__DOMAIN__/passcode) { rewrite ^ /internal/passcode$uri last; }
        try_files $uri $uri/ =404;
    }
}

# http -> https, keeping the ACME challenge path for renewals.
server {
    listen 80;
    server_name __DOMAIN__;
    location /.well-known/acme-challenge/ { root /var/www/acme; }
    location / { return 301 https://$host$request_uri; }
}

# __PARTNER_BEGIN__
# The partner name answers with a redirect to the chosen one, nothing else.
server {
    listen 443 ssl;
    server_name __PARTNER__;
    ssl_certificate     /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
    location / { return 301 https://__DOMAIN__$request_uri; }
}
server {
    listen 80;
    server_name __PARTNER__;
    location /.well-known/acme-challenge/ { root /var/www/acme; }
    location / { return 301 https://__DOMAIN__$request_uri; }
}
# __PARTNER_END__
