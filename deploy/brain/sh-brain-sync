#!/bin/bash
# Rebuilds the owner's product knowledge bundle (simple-host.app/brain/mcp) from origin/main of
# github.com/vineetu/simple-host and simple-host-enterprise, using the installed binary's
# `brain-build`, and swaps it into $BRAIN_DIR/bundle.json by rename; the server picks it up
# within seconds, no restart. Runs hourly (sh-brain-sync.timer) and after every hosted deploy.
# Silent when it works; Signals the owner (from the Hermes number) on any failure.
# Runs as ubuntu (git is authenticated as vineetu). Install:
#   sudo install -m 755 deploy/brain/sh-brain-sync /usr/local/bin/ && sudo install -m 644 deploy/brain/sh-brain-sync.service deploy/brain/sh-brain-sync.timer /etc/systemd/system/
set -u
export PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin"
BASE=/var/lib/sh-brain-sync
OUT="${BRAIN_DIR:-/var/lib/sh-brain}/bundle.json"
BIN="${BRAIN_BIN:-/usr/local/bin/simple-host}"
send(){ curl -s -m 20 -X POST http://127.0.0.1:8086/api/v1/rpc -H 'Content-Type: application/json' -d "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"send\",\"params\":{\"account\":\"+14087851701\",\"recipient\":[\"+19493969884\"],\"message\":$(python3 -c 'import json,sys;print(json.dumps(sys.argv[1]))' "$1")}}" >/dev/null; }
fail(){ echo "$1" >&2; send "Brain sync failed: $1"; exit 1; }
# One run at a time (the timer and a post-deploy run can meet).
mkdir -p "$BASE" || fail "could not create $BASE."
exec 9>>"$BASE/.lock"
flock -w 600 9 || fail "another sh-brain-sync run held the lock for 10 minutes."
for repo in simple-host simple-host-enterprise; do
  dir="$BASE/$repo"
  if [ ! -d "$dir/.git" ]; then
    git clone -q "https://github.com/vineetu/$repo.git" "$dir" 2>&1 || fail "could not clone github.com/vineetu/$repo into $dir."
  fi
  out=$(git -C "$dir" fetch -q --tags --force origin main 2>&1 && git -C "$dir" reset -q --hard origin/main 2>&1 && git -C "$dir" clean -qfdx 2>&1) || fail "could not update $dir to origin/main: $(echo "$out" | tail -3)"
done
out=$("$BIN" brain-build -host "$BASE/simple-host" -enterprise "$BASE/simple-host-enterprise" -out "$OUT" 2>&1) || fail "brain-build at simple-host $(git -C "$BASE/simple-host" rev-parse --short HEAD) and enterprise $(git -C "$BASE/simple-host-enterprise" rev-parse --short HEAD) failed: $(echo "$out" | tail -3). The last good bundle is still served."
echo "$out"
