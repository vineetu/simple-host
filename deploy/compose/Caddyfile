{
	# No `email` directive on purpose. Caddy substitutes an unset environment
	# variable as nothing, and a bare `email` fails to parse, which crash-loops
	# the container for any organiser who did not set one. Let's Encrypt allows
	# account registration without an address; it is only used for expiry
	# notices, and these instances are short-lived.
	admin off
}

# Dashboard, sign-in and API. Separate origin from user content on purpose:
# participant pages must never share an origin with the admin UI.
{$SITE_ADDR:setup-pending.invalid} {
	reverse_proxy app:8090
}

# Setup mode. The two blocks above are given an address that can never resolve
# when their variables are unset, so they are inert rather than a parse error.
# A box installed from a catalog has no hostname yet, and the person
# who created it only knows its IP address. Serve that address over plain HTTP
# so the setup page is reachable before any certificate can exist.
:80 {
	reverse_proxy app:8090
}

# Content host. Every site is served by PATH under one origin:
#   /<handle>/<site>/<rest>  ->  handles/<handle>/<site>/current/<rest>
# The app is not in the content path; Caddy serves the bytes off disk.
{$CONTENT_ADDR:sites.setup-pending.invalid} {
	# Access log for the analytics ingester. Caddy writes JSON; the ingester
	# reads it directly. Only the content host is logged, because only content
	# requests are page views.
	log {
		output file /var/log/caddy/access.log {
			# Caddy runs as root in its official image; the server runs as
			# nonroot. Without an explicit mode the log is created 0600 and the
			# ingester gets permission denied on every run, which shows up as
			# every site reporting zero views rather than as an error anyone
			# would notice.
			mode 644
			roll_size 64MiB
			roll_keep 8
		}
		format json
	}

	@api path /v1/* /internal/*
	handle @api {
		reverse_proxy app:8090
	}
	handle {
		@nodir path_regexp nodir ^/([a-z0-9-]{1,39})/([a-z0-9-]{1,63})$
		redir @nodir {uri}/ 308

		@site path_regexp site ^/([a-z0-9-]{1,39})/([a-z0-9-]{1,63})(/.*)?$
		rewrite @site /{re.site.1}/{re.site.2}/current{re.site.3}
		root * /data/sites/handles
		file_server
	}
}
