{
	# No `email` directive on purpose. Caddy substitutes an unset environment
	# variable as nothing, and a bare `email` fails to parse, which crash-loops
	# the container for any organiser who did not set one. Let's Encrypt allows
	# account registration without an address; it is only used for expiry
	# notices, and these instances are short-lived.
	admin off

	# Certificates are fetched the first time a hostname is asked for, after the
	# application confirms the name is its own.
	#
	# This is what lets a box be installed before it knows where it lives. The
	# hostname never appears in this file, so setup does not have to rewrite
	# configuration it cannot reach, and nothing has to be restarted: the
	# application records the choice, and the next request for that name gets a
	# certificate.
	on_demand_tls {
		ask http://app:8090/internal/tls-ask
	}
}

# Every hostname this instance answers to, over HTTPS.
https:// {
	tls {
		on_demand
	}

	log {
		# Access log for the analytics ingester. Caddy writes JSON; the ingester
		# reads it directly.
		output file /var/log/caddy/access.log {
			# Caddy runs as root in its official image; the server runs as
			# nonroot. Without an explicit mode the log is created 0600 and the
			# ingester gets permission denied on every run, which shows up as
			# every site reporting zero views rather than as an error anyone
			# would notice.
			mode 644
			roll_size 64MiB
			roll_keep 8
		}
		format json
	}

	# The API belongs to the application on every hostname.
	@api path /v1/* /internal/*
	handle @api {
		reverse_proxy app:8090
	}

	# Participant content lives on sites.<dashboard>, matched by shape rather
	# than by name, because the name is not known when this file is written.
	# Serving it here keeps the application out of the content path.
	# A regex, not `host sites.*`: Caddy's host wildcard covers exactly one
	# label, so `sites.*` matches sites.example but never
	# sites.event.example.com, which is the shape every event actually uses.
	@content header_regexp Host ^sites\.
	handle @content {
		@nodir path_regexp nodir ^/([a-z0-9-]{1,39})/([a-z0-9-]{1,63})$
		redir @nodir {uri}/ 308

		@site path_regexp site ^/([a-z0-9-]{1,39})/([a-z0-9-]{1,63})(/.*)?$
		rewrite @site /{re.site.1}/{re.site.2}/current{re.site.3}
		root * /data/sites/handles
		file_server
	}

	# Everything else is the dashboard, sign-in and, before setup, the setup page.
	handle {
		reverse_proxy app:8090
	}
}

# Plain HTTP on the raw address. A box installed from a catalog has no hostname
# yet, and the person who created it only knows its IP, so the setup page has to
# be reachable before any certificate can exist.
:80 {
	reverse_proxy app:8090
}
