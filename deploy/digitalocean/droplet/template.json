{
  "variables": {
    "do_api_token": "{{env `DIGITALOCEAN_API_TOKEN`}}",
    "image_name": "simple-host-24-04-snapshot-{{timestamp}}",
    "region": "nyc3",
    "size": "s-1vcpu-1gb",
    "apt_lock_timeout": "600",
    "apt_packages": "apt-transport-https bind9-dnsutils ca-certificates curl gnupg jq openssl ufw",
    "application_name": "Simple Host",
    "application_version": "0.7.4",
    "installer_release": "v0.7.4",
    "installer_commit": "970c5afdb8b2bd105420bb5adeadabe0663da3ca",
    "installer_sha256": "8c579ef16eac0b5116a70e5f7d733b12411d21e16ee3e84e1d8bccaa8726fb6e"
  },
  "sensitive-variables": ["do_api_token"],
  "builders": [
    {
      "type": "digitalocean",
      "api_token": "{{user `do_api_token`}}",
      "image": "ubuntu-24-04-x64",
      "region": "{{user `region`}}",
      "size": "{{user `size`}}",
      "ssh_username": "root",
      "snapshot_name": "{{user `image_name`}}"
    }
  ],
  "provisioners": [
    {
      "type": "shell",
      "inline": [
        "cloud-init status --wait || [ $? -eq 2 ]"
      ]
    },
    {
      "type": "file",
      "source": "{{template_dir}}/files/etc/",
      "destination": "/etc/"
    },
    {
      "type": "file",
      "source": "{{template_dir}}/files/opt/",
      "destination": "/opt/"
    },
    {
      "type": "file",
      "source": "{{template_dir}}/files/var/",
      "destination": "/var/"
    },
    {
      "type": "shell",
      "environment_vars": [
        "DEBIAN_FRONTEND=noninteractive",
        "LC_ALL=C",
        "LANG=en_US.UTF-8",
        "LC_CTYPE=en_US.UTF-8"
      ],
      "inline": [
        "apt -qqy -o DPkg::Lock::Timeout={{user `apt_lock_timeout`}} update",
        "apt -qqy -o DPkg::Lock::Timeout={{user `apt_lock_timeout`}} -o Dpkg::Options::='--force-confdef' -o Dpkg::Options::='--force-confold' full-upgrade",
        "apt -qqy -o DPkg::Lock::Timeout={{user `apt_lock_timeout`}} -o Dpkg::Options::='--force-confdef' -o Dpkg::Options::='--force-confold' install {{user `apt_packages`}}",
        "apt-get -qqy clean"
      ]
    },
    {
      "type": "shell",
      "environment_vars": [
        "application_name={{user `application_name`}}",
        "application_version={{user `application_version`}}",
        "APT_LOCK_TIMEOUT_SECONDS={{user `apt_lock_timeout`}}",
        "installer_release={{user `installer_release`}}",
        "installer_commit={{user `installer_commit`}}",
        "installer_sha256={{user `installer_sha256`}}",
        "DEBIAN_FRONTEND=noninteractive",
        "LC_ALL=C",
        "LANG=en_US.UTF-8",
        "LC_CTYPE=en_US.UTF-8"
      ],
      "scripts": [
        "{{template_dir}}/scripts/010-docker.sh",
        "{{template_dir}}/scripts/011-simple-host.sh",
        "{{template_dir}}/scripts/014-ufw-http.sh",
        "{{template_dir}}/scripts/018-force-ssh-logout.sh",
        "{{template_dir}}/scripts/020-application-tag.sh",
        "{{template_dir}}/scripts/900-cleanup.sh",
        "{{template_dir}}/scripts/950-final-cleanup.sh",
        "{{template_dir}}/scripts/999-img_check.sh"
      ]
    }
  ]
}
