[Unit]
Description=Issue Simple Host per-person site-host certificates (*.<handle>.simple-host.site)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/simple-host-site-certs-site.conf

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/simple-host-site-certs /etc/simple-host-site-certs-site.conf
TimeoutStartSec=45min
