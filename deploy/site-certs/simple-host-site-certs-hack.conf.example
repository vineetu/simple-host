# /etc/simple-host-site-certs-hack.conf
# The simple-hack.app instance of simple-host-site-certs (event hosts
# <event>.simple-hack.app ride the platform wildcard; team sites
# <team>.<event>.simple-hack.app need a *.<event>.simple-hack.app
# certificate each). Read by simple-host-site-certs-hack.service and, for
# renewals, by the deploy hook (it matches lineages by SITE_DOMAIN).
# SITE_DOMAIN, STATE and NGINX_CERTS are required here.
SITE_DOMAIN=simple-hack.app
STATE=/var/lib/simple-host-site-certs-hack
NGINX_CERTS=/etc/nginx/simple-host-site-certs-hack
# The Go service (simplehack) writes request files here.
REQUESTS_OWNER=simplehack
# Queue bounds; LE rate limits enter the Google/ZeroSSL fallback chain.
BUDGET=10000
DAILY=1000
PER_RUN=30
# RETRY_AFTER=21600
# IP=  # A record target; default: simple-hack.app's apex A record at Vercel

# Shared /etc/simple-host-cert-issuers.conf defaults CERT_FALLBACK_CA=google,zerossl.
# CERT_FALLBACK_CA=none  # disable new fallbacks for this instance
