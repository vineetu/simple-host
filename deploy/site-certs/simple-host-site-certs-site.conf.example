# /etc/simple-host-site-certs-site.conf
# The simple-host.site instance of simple-host-site-certs (person hosts
# <handle>.simple-host.site ride the platform wildcard; site hosts
# <site>.<handle>.simple-host.site need a *.<handle>.simple-host.site
# certificate each). Read by simple-host-site-certs-site.service and, for
# renewals, by the deploy hook (it matches lineages by SITE_DOMAIN).
# SITE_DOMAIN, STATE and NGINX_CERTS are required here.
SITE_DOMAIN=simple-host.site
STATE=/var/lib/simple-host-site-certs-site
NGINX_CERTS=/etc/nginx/simple-host-site-certs-site
# Queue bounds; LE rate limits enter the Google/ZeroSSL fallback chain.
BUDGET=10000
DAILY=1000
PER_RUN=30
# RETRY_AFTER=21600
# IP=  # A record target; default: simple-host.site's apex A record at Vercel

# Shared /etc/simple-host-cert-issuers.conf defaults CERT_FALLBACK_CA=google,zerossl.
# CERT_FALLBACK_CA=none  # disable new fallbacks for this instance
