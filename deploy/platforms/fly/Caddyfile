# Caddy for the small box on Fly.io: deploy/compose/Caddyfile with the TLS
# parts removed. Fly's edge terminates HTTPS (`fly certs add`) and forwards
# plain HTTP to port 8080. Caddy is still needed: it serves published sites
# straight from the volume, hides /internal/*, and writes the access log that
# visitor analytics reads. The server alone does none of that.
{
	admin off
	auto_https off
	servers {
		# Fly's proxy connects from its private network and names the visitor
		# in Fly-Client-IP. Trusting it gives the access log (visitor
		# analytics) and the server's rate limits the visitor's address
		# instead of the proxy's.
		trusted_proxies static private_ranges
		client_ip_headers Fly-Client-IP
	}
}

(app) {
	reverse_proxy 127.0.0.1:8090 {
		# The server rate-limits by the LAST X-Forwarded-For entry. Behind
		# Fly that would be Fly's proxy for every visitor (one shared bucket),
		# so it is replaced with the visitor's address alone.
		header_up X-Forwarded-For {client_ip}
		header_up X-Forwarded-Proto https
	}
}

:8080 {
	log {
		output file /data/caddy-logs/access.log {
			mode 644
			roll_size 64MiB
			roll_at 00:00
			roll_keep 35
			roll_keep_for 672h
		}
		format json
	}
	# Fly's health checks hit /healthz many times a minute; logged, they
	# would add hundreds of MB a day to a 1 GB volume.
	@health path /healthz
	log_skip @health

	# /internal/* is for this file's own rewrites: from outside it is not found.
	@internal path /internal/*
	handle @internal {
		respond 404
	}

	@api path /v1/*
	handle @api {
		import app
	}

	@content header_regexp Host ^sites\.
	handle @content {
		route {
			@nodir path_regexp nodir ^/([a-z0-9-]{1,39})/([a-z0-9-]{1,63})$
			redir @nodir {uri}/ 308

			@site path_regexp site ^/([a-z0-9-]{1,39})/([a-z0-9-]{1,63})(/.*)?$
			route @site {
				@domainredirect file {
					root /data/sites/handles
					try_files /{re.site.1}/{re.site.2}/domain-redirect
				}
				route @domainredirect {
					rewrite * /internal/domain-redirect/{re.site.1}/{re.site.2}{re.site.3}
					import app
				}
				@suspended file {
					root /data/sites/handles
					try_files /{re.site.1}/{re.site.2}/suspended
				}
				route @suspended {
					rewrite * /internal/suspended
					import app
				}
				@offline file {
					root /data/sites/handles
					try_files /{re.site.1}/{re.site.2}/offline
				}
				route @offline {
					rewrite * /internal/offline
					import app
				}
				# Passcode lock (after offline): the app's gate gets
				# /internal/passcode/<handle>/<site>/...?query.
				@passcode file {
					root /data/sites/handles
					try_files /{re.site.1}/{re.site.2}/passcode
				}
				route @passcode {
					rewrite * /internal/passcode{uri}
					import app
				}
				@nosite not file {
					root /data/sites/handles
					try_files /{re.site.1}/{re.site.2}/current/
				}
				route @nosite {
					rewrite * /internal/site-redirect/{re.site.1}/{re.site.2}{re.site.3}
					import app
				}
				rewrite * /{re.site.1}/{re.site.2}/current{re.site.3}
				root * /data/sites/handles
				file_server
			}

			@person path_regexp person ^/([a-z0-9-]{1,39})/?$
			route @person {
				rewrite * /internal/showcase/{re.person.1}
				import app
			}

			rewrite * /internal/notfound
			reverse_proxy 127.0.0.1:8090 {
				header_up X-Original-URI {http.request.orig_uri}
				header_up X-Forwarded-For {client_ip}
				header_up X-Forwarded-Proto https
			}
		}
	}

	handle_errors 404 {
		@contentmiss header_regexp Host ^sites\.
		route @contentmiss {
			rewrite * /internal/notfound
			reverse_proxy 127.0.0.1:8090 {
				header_up X-Original-URI {http.request.orig_uri}
				header_up X-Forwarded-For {client_ip}
				header_up X-Forwarded-Proto https
			}
		}
	}

	handle {
		import app
	}
}
