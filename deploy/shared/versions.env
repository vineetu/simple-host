# Existing release pins; D4-S11 unifies the two release families.
RELEASE_VERSION=0.7.22
HACK_RELEASE_VERSION=0.8.20
HOST_IMAGE=ghcr.io/vineetu/simple-host
HACK_IMAGE=ghcr.io/vineetu/simple-hack
HOST_LOCAL_IMAGE=simple-host:local
POSTGRES_IMAGE=postgres:16-alpine
CADDY_IMAGE=caddy:2-alpine
HACK_CADDY_IMAGE=caddy:2.11.4-alpine
HTTP_PORT=80
HTTPS_PORT=443
APP_PORT=8090
STATIC_PORT=8092
HACK_HTTP_PORT=8081
HACK_HTTPS_PORT=8443
HACK_HEALTH_PORT=8080
HACK_HEALTH_BIND_PORT=18080
# Current standalone limits, preserved here; whole-install sizing is D4-S5b.
HACK_APP_MEMORY=1g
HACK_DB_MEMORY=512m
