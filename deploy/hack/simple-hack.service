[Unit]
Description=simple-hack.app (Simple Hack)
After=network.target postgresql.service

[Service]
Type=simple
User=simplehack
Group=simplehack
EnvironmentFile=/etc/simple-hack.env
# Site secrets' master key (SECRETS_KEY_FILE): in the unit's own state
# directory, writable here, never served and outside the database. Back it
# up separately from the database; lose it and saved keys cannot be recovered.
StateDirectory=simple-hack
StateDirectoryMode=0700
Environment=SECRETS_KEY_FILE=/var/lib/simple-hack/secrets.key
ExecStart=/usr/local/bin/simple-hack
Restart=on-failure
RestartSec=2
MemoryMax=768M
ReadWritePaths=/srv/simple-hack/sites
ReadWritePaths=-/var/lib/simple-host-site-certs-hack/requests

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_INET AF_INET6
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0027

[Install]
WantedBy=multi-user.target
