# /etc/simple-hack.env — environment for simple-hack.service.
# Copy is created by deploy/hack/setup-instance.sh (0600 root:root) on first
# apply; this file is the documented values. Secrets marked
# <generated by setup-instance.sh> are not committed.

# The hosted-events instance: the apex is the app, events at
# <event>.simple-hack.app, team sites at <team>.<event>.simple-hack.app.
SITE_DOMAIN=simple-hack.app
PUBLIC_BASE_URL=https://simple-hack.app
# Loopback only; nginx on this box proxies simple-hack.app here.
PORT=8091
BIND_ADDR=127.0.0.1
DATA_DIR=/srv/simple-hack/sites
EVENTS=hosted
PERSON_HOSTS=canonical
SITE_HOSTS=canonical
SITE_CERT_DIR=/var/lib/simple-host-site-certs-hack
# Smaller than simple-host.app: team sites are short-lived.
MAX_ARCHIVE_MB=25
KEEP_VERSIONS=2
# simple-host.app on the same box, for the shared name list.
EVENT_NAME_PEER=http://127.0.0.1:8090
ANALYTICS_LOG=/var/log/simple-hack/analytics.log
# This box's public IPv4, for custom-domain A records.
CUSTOM_DOMAIN_IP=147.224.49.228
WRITE_AUTH_MODE=on
MAIL_FROM=Simple Hack <noreply@simple-host.app>

# Secrets: generated on first setup-instance.sh --apply; never printed.
DB_DSN=<generated by setup-instance.sh>
ADMIN_API_KEY=<generated by setup-instance.sh>
PASSCODE_ENC_KEY=<generated by setup-instance.sh>
ANALYTICS_SALT=<generated by setup-instance.sh>
# Copied from /etc/simple-host.env (same mail and Google app).
RESEND_API_KEY=<generated by setup-instance.sh>
GOOGLE_OAUTH_CLIENT_ID=<generated by setup-instance.sh>
GOOGLE_OAUTH_CLIENT_SECRET=<generated by setup-instance.sh>

# Hosted-event limits; unset keeps the defaults in docs/advanced/hosted-events.md.
#EVENT_CREATE_PER_DAY=3
#EVENT_MAX_ACTIVE_PER_ORGANISER=2
#EVENT_TEAM_SIZE_DEFAULT=4
#EVENT_SITES_KEEP_DAYS=30
#HACK_INSTANCE_BUDGET_GB=10
