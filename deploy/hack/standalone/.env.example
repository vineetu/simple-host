# Leave unset to use the image of the release you downloaded.
#SIMPLE_HACK_IMAGE=
SITE_DOMAIN=hack.example.com
# Password accounts need neither Resend nor OIDC.
PASSWORD_SIGNIN=on
PASSWORD_SELF_SIGNUP=on
RESEND_API_KEY=
MAIL_FROM=
# install.sh generates these once: hex passwords/salt and a base64 passcode key.
DB_PASSWORD=
ADMIN_API_KEY=
PASSCODE_ENC_KEY=
ANALYTICS_SALT=
# Company sign-in (optional): set all three to turn it on; RESEND_API_KEY and
# MAIL_FROM then become optional. See "Company sign-in and private networks"
# in docs/platforms/simple-hack-standalone.md.
#OIDC_ISSUER=
#OIDC_CLIENT_ID=
#OIDC_CLIENT_SECRET=
#ALLOWED_EMAIL_DOMAINS=
#OIDC_LABEL=
#OIDC_INSECURE_ALLOWED=
# on (default) or off. Refused at startup unless company or password sign-in is configured.
#EMAIL_SIGNIN=on
# public (default), internal, acme or certs; set with --tls at install time.
# acme also needs ACME_CA; certs needs --cert-dir at install time.
#TLS_MODE=public
#ACME_CA=

# Optional MCP Apps screens. Dashboard requires My sites.
MCP_APP_MY_SITES=off
MCP_APP_DASHBOARD=off

# Your support contact shown on pages.
#SUPPORT_EMAIL=
# Your own privacy policy, linked from the footer.
#PRIVACY_URL=
# The organiser Ask assistant stays off until ASSISTANT_BASE_URL and ASSISTANT_MODEL point at an OpenAI-compatible endpoint.
#ASSISTANT_BASE_URL=
#ASSISTANT_MODEL=
#ASSISTANT_API_KEY=
# Change which address and port the server listens on.
#HTTP_BIND=0.0.0.0:80
#HTTPS_BIND=0.0.0.0:443
