# Candidate: publish the v0.8.0 application and package image before use.
SIMPLE_HACK_IMAGE=ghcr.io/vineetu/simple-hack:0.8.0
SITE_DOMAIN=hack.example.com
RESEND_API_KEY=
MAIL_FROM=
# install.sh generates these once: hex passwords/salt and a base64 passcode key.
DB_PASSWORD=
ADMIN_API_KEY=
PASSCODE_ENC_KEY=
ANALYTICS_SALT=
# Company sign-in (optional): set all three to turn it on; RESEND_API_KEY and
# MAIL_FROM then become optional. See "Company sign-in and running inside
# your network" in docs/platforms/simple-hack-standalone.md.
#OIDC_ISSUER=
#OIDC_CLIENT_ID=
#OIDC_CLIENT_SECRET=
#ALLOWED_EMAIL_DOMAINS=
#OIDC_LABEL=
#OIDC_INSECURE_ALLOWED=
# on (default) or off. Refused at startup unless company sign-in is configured.
#EMAIL_SIGNIN=on
# public (default), internal, acme or certs; set with --tls at install time.
# acme also needs ACME_CA; certs needs --cert-dir at install time.
#TLS_MODE=public
#ACME_CA=

# Optional MCP Apps screens. Dashboard requires My sites.
MCP_APP_MY_SITES=off
MCP_APP_DASHBOARD=off
