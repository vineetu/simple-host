        "                  tableEditors.forEach(function(editor, table) {",
        "                    editing = editor;",
        "                    var rules = JSON.parse(editor.textarea.value);",
        "                    if (!rules || typeof rules !== 'object' || Array.isArray(rules)) throw new Error('Enter a rules JSON object.');",
        "                    body.tables[table] = {rules: rules};",
        "                  });",
        "                }",
        "              } catch (err) {",
        "                editing.error.textContent = err.message; editing.error.hidden = false;",
        "                editing.textarea.setAttribute('aria-invalid', 'true'); editing.textarea.focus(); return;",
        "            } else {",
        "              body.preset = form.elements.preset.value;",
        "              if (body.preset === 'keep') {",
        "                if (resource.preset === 'legacy') { message.textContent = 'Pick a preset to change this resource; its old rules stay until you do.'; return; }",
        "                body.preset = 'custom'; body.read = resource.access.read; body.add = resource.access.add; body.edit = resource.access.edit; body.delete = resource.access.delete;",
        "              }",
        "              // approve_first goes with the comments preset on Tables; leaving",
        "              // the preset turns it off (the server refuses it without one),",
        "              // unless a table keeps its own comments preset.",
        "              var tableComments = tables.some(function(t) { return resource.tables[t].preset === 'comments'; });",
        "              if (body.kind === 'sqlite' && body.preset === 'comments' && form.elements.approve) body.approve_first = form.elements.approve.checked;",
        "              else if (resource.approve_first && body.preset !== 'custom' && !tableComments) body.approve_first = false;",
        "              if (resource.name && body.preset !== 'keep' && body.preset !== 'custom') {",
        "                var oldReach = storageReadReach(resource.preset || 'private');",
        "                var newReach = storageReadReach(body.preset);",
        "                if (oldReach >= 0 && newReach > oldReach && newReach >= 2) {",
        "                  var openTitle = newReach >= 3",
        "                    ? 'Open \"' + resource.name + '\" to everyone?'",
        "                    : 'Open \"' + resource.name + '\" to signed-in people?';",
        "                  var openBody = newReach >= 3",
        "                    ? 'Anyone will be able to read everything already saved here, not just new entries.'",
        "                    : 'Anyone who signs in on this site will be able to read everything already saved here, not just new entries.';",
        "                  if (!(await shConfirm({ title: openTitle, body: openBody, confirmLabel: 'Open it up', danger: true }))) return;",
        "                }",
        "              }",
        "              if (!res.ok) {",
        "                var failure = await res.json();",
        "                if (hasRules && failure.rule_error) { showRuleError(failure.rule_error); return; }",
        "                throw new Error(failure.error || 'Could not save policy');",
        "              }",
        "            finally { button.disabled = false; }"
      ]
    }
  ]
}
