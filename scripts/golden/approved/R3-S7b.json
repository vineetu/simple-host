{
  "slice": "R3-S7b",
  "entries": [
    {
      "product": "host",
      "request": "showcase-page",
      "reason": "R3-S7b adds rules editing, positioned diagnostics, table overrides and conversion labels inside the Storage panel; file buckets retain their preset control.",
      "at": "text",
      "removed": [
        "            '<div class=\"panel-field\"><label for=\"' + id + '-preset\">Who can do what?</label><select id=\"' + id + '-preset\" name=\"preset\">' + options(choices, current) + '</select>' + tableNote + '</div>' +",
        "            (SHOWCASE.spamCheck ? '<label class=\"panel-check\" data-approve><input type=\"checkbox\" name=\"approve\" value=\"1\"' + (resource.approve_first ? ' checked' : '') + '> Hold new posts until you approve them (Tables only; approve from your AI app, e.g. &ldquo;approve post 12&rdquo;)</label>' : '') +",
        "          form.elements.preset.addEventListener('change', syncApprove);",
        "            var message = form.querySelector('[aria-live]'), button = form.querySelector('button[type=\"submit\"]');",
        "            var body = {kind: resource.name ? resource.kind : form.elements.kind.value, preset: form.elements.preset.value, site_passcode: form.elements.passcode.value};",
        "            if (body.preset === 'keep') {",
        "              if (resource.preset === 'legacy') { message.textContent = 'Pick a preset to change this resource; its old rules stay until you do.'; return; }",
        "              body.preset = 'custom'; body.read = resource.access.read; body.add = resource.access.add; body.edit = resource.access.edit; body.delete = resource.access.delete;",
        "            }",
        "            // approve_first goes with the comments preset on Tables; leaving",
        "            // the preset turns it off (the server refuses it without one),",
        "            // unless a table keeps its own comments preset.",
        "            var tableComments = tables.some(function(t) { return resource.tables[t].preset === 'comments'; });",
        "            if (body.kind === 'sqlite' && body.preset === 'comments' && form.elements.approve) body.approve_first = form.elements.approve.checked;",
        "            else if (resource.approve_first && body.preset !== 'custom' && !tableComments) body.approve_first = false;",
        "            if (resource.name && body.preset !== 'keep' && body.preset !== 'custom') {",
        "              var oldReach = storageReadReach(resource.preset || 'private');",
        "              var newReach = storageReadReach(body.preset);",
        "              if (oldReach >= 0 && newReach > oldReach && newReach >= 2) {",
        "                var openTitle = newReach >= 3",
        "                  ? 'Open \"' + resource.name + '\" to everyone?'",
        "                  : 'Open \"' + resource.name + '\" to signed-in people?';",
        "                var openBody = newReach >= 3",
        "                  ? 'Anyone will be able to read everything already saved here, not just new entries.'",
        "                  : 'Anyone who signs in on this site will be able to read everything already saved here, not just new entries.';",
        "                if (!(await shConfirm({ title: openTitle, body: openBody, confirmLabel: 'Open it up', danger: true }))) return;",
        "              if (!res.ok) throw new Error(await errorOf(res, 'Could not save policy'));",
        "            button.disabled = false;"
      ],
      "added": [
        "          var hasRules = resource.kind !== 'files' && resource.rules != null;",
        "            (hasRules ? '<p class=\"panel-note\">Rules' + (resource.rules_status === 'invalid' ? ' \u00b7 needs repair' : '') + '</p><div data-rule-editors></div>' :",
        "            (resource.name && resource.kind !== 'files' ? '<p class=\"panel-note\">Not converted. Presets are ending; rules replace them.</p>' : '') +",
        "            '<div class=\"panel-field\"><label for=\"' + id + '-preset\">Who can do what?</label><select id=\"' + id + '-preset\" name=\"preset\">' + options(choices, current) + '</select>' + tableNote + '</div>') +",
        "            (!hasRules && SHOWCASE.spamCheck ? '<label class=\"panel-check\" data-approve><input type=\"checkbox\" name=\"approve\" value=\"1\"' + (resource.approve_first ? ' checked' : '') + '> Hold new posts until you approve them (Tables only; approve from your AI app, e.g. &ldquo;approve post 12&rdquo;)</label>' : '') +",
        "          var ruleEditors = [], tableEditors = new Map();",
        "          function ruleEditor(set, table) {",
        "            var field = document.createElement('div'), editorID = id + '-rules-' + ruleEditors.length;",
        "            field.className = 'panel-field';",
        "            field.innerHTML = '<label for=\"' + editorID + '\">' + (table ? 'Table: ' + esc(table) : 'Default rules') + '</label>' +",
        "              '<div data-policies></div><textarea id=\"' + editorID + '\" rows=\"10\" spellcheck=\"false\" aria-describedby=\"' + editorID + '-error\"></textarea>' +",
        "              '<div class=\"panel-err\" id=\"' + editorID + '-error\" aria-live=\"polite\" hidden></div>';",
        "            var textarea = field.querySelector('textarea'), error = field.querySelector('.panel-err');",
        "            textarea.value = JSON.stringify(set, null, 2);",
        "            function policies() {",
        "              var summary = field.querySelector('[data-policies]');",
        "              summary.textContent = '';",
        "              try {",
        "                var parsed = JSON.parse(textarea.value);",
        "                (parsed.policies || []).forEach(function(policy) {",
        "                  var line = document.createElement('p');",
        "                  line.className = 'panel-hint';",
        "                  line.textContent = policy.name + ': ' + policy.command + ' \u00b7 ' + (policy.restrictive ? 'restrictive' : 'permissive') +",
        "                    (policy.using != null ? ' \u00b7 using ' + policy.using : '') + (policy.check != null ? ' \u00b7 check ' + policy.check : '');",
        "                  summary.appendChild(line);",
        "                });",
        "                if (Array.isArray(parsed.policies) && !parsed.policies.length) summary.textContent = 'No policies: access denied.';",
        "              } catch (e) { /* Keep the JSON available for repair. */ }",
        "            }",
        "            textarea.addEventListener('input', policies);",
        "            policies();",
        "            var editor = {field: field, textarea: textarea, error: error, table: table};",
        "            ruleEditors.push(editor);",
        "            form.querySelector('[data-rule-editors]').appendChild(field);",
        "            if (table) {",
        "              tableEditors.set(table.toLowerCase(), editor);",
        "              var remove = document.createElement('button');",
        "              remove.type = 'button'; remove.className = 'btn-small btn-ghost';",
        "              remove.textContent = 'Remove rules for ' + table;",
        "              remove.addEventListener('click', function() { tableEditors.delete(table.toLowerCase()); field.remove(); });",
        "              field.appendChild(remove);",
        "            }",
        "            return editor;",
        "          }",
        "          function showRuleError(diagnostic) {",
        "            var editor = tableEditors.get((diagnostic.table || '').toLowerCase()) || ruleEditors[0];",
        "            editor.error.hidden = false;",
        "            editor.error.textContent = [diagnostic.table, diagnostic.policy, diagnostic.clause].filter(Boolean).join(' \u00b7 ') +",
        "              (diagnostic.position >= 0 ? ' \u00b7 position ' + diagnostic.position : '') + ': ' + diagnostic.message;",
        "            editor.textarea.setAttribute('aria-invalid', 'true');",
        "            try {",
        "              var set = JSON.parse(editor.textarea.value);",
        "              var policies = set.policies.map(function(policy, index) { return {policy: policy, index: index}; })",
        "                .filter(function(candidate) { return (candidate.policy.name || '') === (diagnostic.policy || ''); });",
        "              // Semantic categories do not identify which expression failed. Show",
        "              // labelled candidates instead of guessing a clause or unnamed policy.",
        "              var clauses = diagnostic.clause === 'using' || diagnostic.clause === 'check' ? [diagnostic.clause] :",
        "                diagnostic.clause === 'anonymous_change' ? ['using'] :",
        "                ['binding', 'type', 'column', 'size'].includes(diagnostic.clause) ? ['using', 'check'] : [];",
        "              policies.forEach(function(candidate) {",
        "                clauses.forEach(function(clause) {",
        "                  var expression = candidate.policy[clause];",
        "                  if (typeof expression !== 'string' || diagnostic.position < 0) return;",
        "                  // Engine positions are UTF-8 byte offsets in the clause, not in the JSON.",
        "                  var chars = Array.from(expression), offset = 0, index = 0;",
        "                  while (index < chars.length && offset < diagnostic.position) offset += new TextEncoder().encode(chars[index++]).length;",
        "                  var excerpt = document.createElement('div'), mark = document.createElement('mark');",
        "                  excerpt.style.overflowWrap = 'anywhere';",
        "                  excerpt.appendChild(document.createTextNode('Policy ' + (candidate.index + 1) + ' \u00b7 ' + clause +",
        "                    (policies.length > 1 || clauses.length > 1 ? ' (candidate): ' : ': ')));",
        "                  excerpt.appendChild(document.createTextNode(chars.slice(0, index).join('')));",
        "                  mark.textContent = chars[index] || ' (end)'; excerpt.appendChild(mark);",
        "                  excerpt.appendChild(document.createTextNode(chars.slice(index + 1).join('')));",
        "                  editor.error.appendChild(excerpt);",
        "                });",
        "              });",
        "            } catch (e) { /* The server diagnostic still identifies the position. */ }",
        "            editor.textarea.focus();",
        "          }",
        "          if (hasRules) {",
        "            ruleEditor(resource.rules, '');",
        "            tables.forEach(function(t) { ruleEditor(resource.tables[t].rules, t); });",
        "            if (resource.kind === 'sqlite') {",
        "              var addTable = document.createElement('div');",
        "              addTable.className = 'panel-field';",
        "              addTable.innerHTML = '<label for=\"' + id + '-table\">Table with its own rules</label><input type=\"text\" id=\"' + id + '-table\" autocomplete=\"off\" spellcheck=\"false\">' +",
        "                '<button type=\"button\" class=\"btn-small btn-secondary\">Add table rules</button><p class=\"panel-hint\">Removing a table\u2019s own set makes it use the default rules after you save.</p>';",
        "              form.querySelector('[data-rule-editors]').appendChild(addTable);",
        "              addTable.querySelector('button').addEventListener('click', function() {",
        "                var input = addTable.querySelector('input'), table = input.value.trim();",
        "                if (!table) { input.focus(); return; }",
        "                var editor = tableEditors.get(table.toLowerCase()) || ruleEditor({policies: []}, table);",
        "                editor.textarea.focus(); input.value = '';",
        "              });",
        "            }",
        "            (resource.rules_errors || []).forEach(showRuleError);",
        "          }",
        "          if (form.elements.preset) form.elements.preset.addEventListener('change', syncApprove);",
        "            var message = form.querySelector('.panel-btns [aria-live]'), button = form.querySelector('button[type=\"submit\"]');",
        "            var body = {kind: resource.name ? resource.kind : form.elements.kind.value, site_passcode: form.elements.passcode.value};",
        "            message.textContent = '';",
        "            if (hasRules) {",
        "              ruleEditors.forEach(function(editor) { editor.error.hidden = true; editor.textarea.removeAttribute('aria-invalid'); });",
        "              var editing = ruleEditors[0];",
        "              try {",
        "                body.rules = JSON.parse(editing.textarea.value);",
        "                // null means preserve to the API; it cannot replace an edited set.",
        "                if (!body.rules || typeof body.rules !== 'object' || Array.isArray(body.rules)) throw new Error('Enter a rules JSON object.');",
        "                if (body.kind === 'sqlite') {",
        "                  body.tables = Object.create(null);",
        "                  tableEditors.forEach(function(editor, table) {",
        "                    editing = editor;",
        "                    var rules = JSON.parse(editor.textarea.value);",
        "                    if (!rules || typeof rules !== 'object' || Array.isArray(rules)) throw new Error('Enter a rules JSON object.');",
        "                    body.tables[table] = {rules: rules};",
        "                  });",
        "                }",
        "              } catch (err) {",
        "                editing.error.textContent = err.message; editing.error.hidden = false;",
        "                editing.textarea.setAttribute('aria-invalid', 'true'); editing.textarea.focus(); return;",
        "            } else {",
        "              body.preset = form.elements.preset.value;",
        "              if (body.preset === 'keep') {",
        "                if (resource.preset === 'legacy') { message.textContent = 'Pick a preset to change this resource; its old rules stay until you do.'; return; }",
        "                body.preset = 'custom'; body.read = resource.access.read; body.add = resource.access.add; body.edit = resource.access.edit; body.delete = resource.access.delete;",
        "              }",
        "              // approve_first goes with the comments preset on Tables; leaving",
        "              // the preset turns it off (the server refuses it without one),",
        "              // unless a table keeps its own comments preset.",
        "              var tableComments = tables.some(function(t) { return resource.tables[t].preset === 'comments'; });",
        "              if (body.kind === 'sqlite' && body.preset === 'comments' && form.elements.approve) body.approve_first = form.elements.approve.checked;",
        "              else if (resource.approve_first && body.preset !== 'custom' && !tableComments) body.approve_first = false;",
        "              if (resource.name && body.preset !== 'keep' && body.preset !== 'custom') {",
        "                var oldReach = storageReadReach(resource.preset || 'private');",
        "                var newReach = storageReadReach(body.preset);",
        "                if (oldReach >= 0 && newReach > oldReach && newReach >= 2) {",
        "                  var openTitle = newReach >= 3",
        "                    ? 'Open \"' + resource.name + '\" to everyone?'",
        "                    : 'Open \"' + resource.name + '\" to signed-in people?';",
        "                  var openBody = newReach >= 3",
        "                    ? 'Anyone will be able to read everything already saved here, not just new entries.'",
        "                    : 'Anyone who signs in on this site will be able to read everything already saved here, not just new entries.';",
        "                  if (!(await shConfirm({ title: openTitle, body: openBody, confirmLabel: 'Open it up', danger: true }))) return;",
        "                }",
        "              }",
        "              if (!res.ok) {",
        "                var failure = await res.json();",
        "                if (hasRules && failure.rule_error) { showRuleError(failure.rule_error); return; }",
        "                throw new Error(failure.error || 'Could not save policy');",
        "              }",
        "            finally { button.disabled = false; }"
      ]
    },
